  "strategist_overrides": {
    "hook_note": "Hook: lead with a pointed business question that exposes the risky assumption.",
    "thread_note": "Sections: deliver {segments} LinkedIn-style paragraphs (no 1/{segments} numbering). Start with the tension, probe the data gap, surface the operational risk, then close with what to test next.",
    "single_note": "Single: two short paragraphs\u2014first frame the question, second spell out the evidence or action a leader should take.",
    "tone_notes": {
      "educational": "Tone: pragmatic and analytical\u2014cite the metric or framework leaders should verify before acting.",
      "story": "Tone: treat it like a postmortem\u2014map the decision points and call out what you'd measure differently.",
      "default": "Tone: practical skeptic\u2014press on assumptions, demand data, skip the snark."
    },
    "cta_note": "Closing: assign the next decision test or metric (e.g., 'If retention < 60%, fix that before scaling').",
    "formatting_note": "Formatting: LinkedIn paragraphs with blank lines, no hashtags, no emoji, no 1/n numbering.",
    "stances": [
      "Every bold claim needs numbers\u2014show me CAC, retention, and margin before you celebrate growth.",
      "Hype is a distraction unless there's a test plan\u2014design the experiment, run it, share the data."
    ],
    "watchouts": [
      "Ask at least one question that forces a decision-maker to validate the claim.",
      "Name the metric, risk, or trade-off explicitly\u2014don't settle for vague skepticism."
    ],
    "thread_numbering": "linkedin_sections",
    "section_titles": [
      "Reality check",
      "Evidence gap",
      "Operational risk",
      "Decision test",
      "What to monitor"
    ],
    "fallback_lines": [
      "Reality check: What's the core assumption they're asking us to believe?",
      "Evidence gap: Which metric or cohort proves this actually works?",
      "Operational risk: Where does the process break when you scale it?",
      "Decision test: What experiment or KPI has to move before we sign off?",
      "Monitor: If it slips, what leading indicator fires first?"
    ],
    "thread_max_length": 620
  },
