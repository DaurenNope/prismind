# Security Configuration for Beyondlines Intelligence Platform
# Copy this file to .env and fill in your actual credentials
# NEVER commit the actual .env file with real credentials to version control
# All sensitive data should be loaded from environment variables

# Database Configuration
SQLITE_DB_PATH=data/beyondlines.db
SUPABASE_URL=your_value_here
SUPABASE_SERVICE_ROLE_KEY=your_value_here

# AI Service Configuration
OPENAI_API_KEY=your_value_here
ANTHROPIC_API_KEY=your_value_here
GOOGLE_AI_API_KEY=your_value_here
SERPAPI_KEY=your_value_here

# Social Media Platform Credentials
# =================================

# Reddit API credentials
REDDIT_CLIENT_ID=your_value_here
REDDIT_CLIENT_SECRET=your_value_here
REDDIT_USERNAME=your_value_here
REDDIT_PASSWORD=your_value_here
REDDIT_USER_AGENT=beyondlines/1.0

# Twitter API credentials
TWITTER_API_KEY=your_value_here
TWITTER_API_SECRET=your_value_here
TWITTER_ACCESS_TOKEN=your_value_here
TWITTER_ACCESS_TOKEN_SECRET=your_value_here
TWITTER_USERNAME=your_value_here
TWITTER_PASSWORD=your_value_here

# Twitter Configuration
TWITTER_EXTRACT_THREADS=true
TWITTER_COOKIES_PATH=config/twitter_cookies.json

# Telegram bot credentials
TELEGRAM_BOT_TOKEN=your_value_here
TELEGRAM_CHAT_ID=your_value_here

# Threads credentials
THREADS_USERNAME=your_value_here
THREADS_PASSWORD=your_value_here
THREADS_COOKIES_PATH=config/threads_cookies.json

# Security Settings
# =================
ENABLE_COOKIE_ENCRYPTION=true
COOKIE_ENCRYPTION_KEY=your_32_character_encryption_key_here