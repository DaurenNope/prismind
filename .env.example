# Copy this file to .env and fill in your API keys

# Reddit API credentials
REDDIT_CLIENT_ID=your_value_here
REDDIT_CLIENT_SECRET=your_value_here
REDDIT_USERNAME=your_value_here
REDDIT_PASSWORD=your_value_here
REDDIT_USER_AGENT=your_value_here

# OpenAI API key
OPENAI_API_KEY=your_value_here

# Telegram bot credentials
TELEGRAM_BOT_TOKEN=your_value_here
TELEGRAM_CHAT_ID=your_value_here

# Twitter API credentials (for future use)
TWITTER_API_KEY=your_value_here
TWITTER_API_SECRET=your_value_here
TWITTER_ACCESS_TOKEN=your_value_here
TWITTER_ACCESS_TOKEN_SECRET=your_value_here

# Twitter login credentials for Playwright scraping
TWITTER_USERNAME=your_value_here
TWITTER_PASSWORD=your_value_here

# Twitter thread extraction (default: true)
# Set to false if thread extraction causes issues
TWITTER_EXTRACT_THREADS=true

# Twitter cookies for direct API access (extract from browser)
# Format: TWITTER_COOKIES=your_value_here
TWITTER_COOKIES=your_value_here

# Threads login credentials for Playwright scraping
THREADS_USERNAME=your_value_here
THREADS_PASSWORD=your_value_here

# Threads cookies for direct API access (extract from browser)
# Format: THREADS_COOKIES=your_value_here
THREADS_COOKIES=your_value_here

SERPAPI_KEY=your_value_here

# Supabase Configuration
SUPABASE_URL=your_value_here
SUPABASE_SERVICE_ROLE_KEY=your_value_here